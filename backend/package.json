{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "start": "npm run emulators",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npm run build && npx --yes firebase-tools@15 emulators:start --only functions",
    "seed:dev": "npm run build && node --env-file=.env --env-file-if-exists=.env.local lib/scripts/seed-dev.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.2"
  },
  "engines": {
    "node": "24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}

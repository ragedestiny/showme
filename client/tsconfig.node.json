// vite.config.ts and the build scripts, which run in Node (see tsconfig.json)
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "skipLibCheck": true,

    // scripts/use-staging-api.js stays JavaScript, because Netlify runs it
    // with plain `node`; it is still checked, using the types TypeScript
    // can work out on its own
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "scripts"]
}

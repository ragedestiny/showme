# One ignore file for the whole repository: these patterns apply in every
# folder (backend/ and client/ alike).

# Downloaded libraries (npm install recreates them)
node_modules/

# Build output (npm run build recreates it)
build/
dist/
coverage/
# The backend's JavaScript, built from its TypeScript (Firebase runs this)
backend/lib/

# Secret settings: never commit these
.env
.env.local
.env.*.local
# Staging secrets kept on this PC only (copied into GitHub secrets by hand)
.env.staging
# The Google credentials file the deploy workflows create while they run
gha-creds-*.json

# Logs (npm's, and the Firebase emulator's firebase-debug.log and ui-debug.log)
*.log
npm-debug.log*

# Claude Code's local settings and notes
.claude/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

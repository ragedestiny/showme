    {
      "id": 10,
      "type": "timeseries",
      "title": "Response time",
      "description": "How long Google measured each answer took, per time slot with traffic (no bar = nobody used the site). Typical (blue) = half of requests were faster; slowest 5% (purple, behind) = only 1 in 20 was slower. The dashed line is 1 second. Spikes after a quiet spell are usually a server starting up.",
      "gridPos": {
        "x": 15,
        "y": 6,
        "w": 9,
        "h": 9
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "${ds_monitoring}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "${ds_monitoring}"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "slowest 5% (p95)",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_latencies",
              "AND",
              "resource.label.service_name",
              "=",
              "apiv2"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "${ds_monitoring}"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "typical (p50)",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_latencies",
              "AND",
              "resource.label.service_name",
              "=",
              "apiv2"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
            "alignmentPeriod": "cloud-monitoring-auto",
            "groupBys": [],
            "view": "FULL",
            "preprocessor": "none"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 1000,
                "color": "red"
              }
            ]
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "lineInterpolation": "linear",
